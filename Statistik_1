      g += `<line x1="${L}" x2="${W - 10}" y1="${Y(mean)}" y2="${Y(mean)}" stroke="#8E5BC9" stroke-width="3" stroke-dasharray="7 5"/><line x1="${L}" x2="${W - 10}" y1="${Y(med)}" y2="${Y(med)}" stroke="#2F8F5B" stroke-width="3"/>`;
