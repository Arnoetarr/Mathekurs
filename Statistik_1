      const d = [...base, x].sort((a, b) => a - b), mean = d.reduce((a, b) => a + b, 0) / 6, med = (d[2] + d[3]) / 2;
      const W = 520, H = 240, L = 46, T = 14, ph = 180, ymax = 200, Y = y => T + ph - y / ymax * ph, bw = 60;
