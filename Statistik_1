        `<p class="big ${n === 20 ? '' : 'warn'}">Lernende: <b>${n}</b>${n === 20 ? '' : ' (es sollen 20 sein)'} &nbsp; Mittelwert: <b>${n ? fmt(sum / n, 2) : '–'}</b> &nbsp; Median: <b>${n ? fmt(med, 1) : '–'}</b> &nbsp; Spannweite: <b>${n ? list[n - 1] - list[0] : '–'}</b></p>`;
    }
    draw();
  }
};

/* ===== Aufgaben darstellen ===== */
const LVL_ICON = { Basis: '✏️', Standard: '✏️', Knobeln: '🧩', Partner: '👥', Computer: '💻', Experten: '🎯', 'Teil A': '✏️', 'Teil B': '✏️' };
function partHTML(p, id) {
  const ok = S.parts[id];
  let inner = `<div class="q">${p.q}</div>`;
  if (p.t === 'num' || p.t === 'frac') {
    inner += `<div class="ans"><input id="in-${id}" ${p.t === 'num' ? 'inputmode="decimal"' : 'inputmode="text" placeholder="z. B. 3/4"'} autocomplete="off" aria-label="Antwort">${p.unit ? `<span class="unit">${p.unit}</span>` : ''}<button class="btn check" data-id="${id}">Prüfen</button></div>`;
  } else if (p.t === 'choice') {
    inner += `<div class="opts">${p.opts.map((o, i) => `<button class="btn opt" data-id="${id}" data-i="${i}">${o}</button>`).join('')}</div>`;
  } else {
    inner += `<div class="ans"><button class="btn ghost show" data-id="${id}">Lösung zeigen</button></div>`;
  }
  inner += `<div class="fb" id="fb-${id}" aria-live="polite"></div>`;
  return `<div class="part ${ok ? 'ok' : ''}" id="p-${id}">${inner}</div>`;
}
function solText(p) {
  if (p.sol) return p.sol;
  if (p.t === 'num') return `${fmt(p.ans, 3)}${p.unit ? ' ' + p.unit : ''}`;
  if (p.t === 'frac') return FR(p.n, p.d);
  if (p.t === 'choice') return p.opts[p.ok];
  return '';
}
const PARTS = {};
function bindParts(root) {
  root.querySelectorAll('.check').forEach(b => {
    const id = b.dataset.id, p = PARTS[id], inp = $('#in-' + id), fb = $('#fb-' + id);
    let tries = 0;
    const run = () => {
      let right = false;
      if (p.t === 'num') { const v = parseNum(inp.value); if (isNaN(v)) { fb.innerHTML = '<span class="no">Gib eine Zahl ein.</span>'; return; } right = Math.abs(v - p.ans) <= p.tol + 1e-9; }
      else { const m = inp.value.replace(/\s/g, '').match(/^(\d+)\/(\d+)$/); if (!m) { fb.innerHTML = '<span class="no">Schreibe den Bruch so: 3/4</span>'; return; }
        const a = +m[1], c = +m[2]; right = a * p.d === c * p.n && gcd(a, c) === 1;
        if (!right && a * p.d === c * p.n) { fb.innerHTML = '<span class="no">Richtiger Wert, aber noch nicht vollständig gekürzt.</span>'; tries++; return; } }
      tries++;
      if (right) { S.parts[id] = true; save(); $('#p-' + id).classList.add('ok'); fb.innerHTML = `<span class="yes">Richtig!</span>${p.sol ? `<div class="sol">${p.sol}</div>` : ''}`; updateStats(); }
      else fb.innerHTML = `<span class="no">Noch nicht. Prüfe deine Rechnung im Hefter.</span>${tries >= 2 ? `<button class="btn ghost small reveal">Lösung zeigen</button>` : ''}`;
      const rv = fb.querySelector('.reveal'); if (rv) rv.onclick = () => { fb.innerHTML = `<div class="sol">Lösung: ${solText(p)}</div>`; };
    };
    b.onclick = run; inp.onkeydown = e => { if (e.key === 'Enter') run(); };
  });
  root.querySelectorAll('.opts').forEach(box => {
    box.querySelectorAll('.opt').forEach(b => b.onclick = () => {
      const id = b.dataset.id, p = PARTS[id], fb = $('#fb-' + id), right = +b.dataset.i === p.ok;
      box.querySelectorAll('.opt').forEach(x => x.classList.remove('sel', 'wrong'));
      b.classList.add(right ? 'sel' : 'wrong');
      if (right) { S.parts[id] = true; save(); $('#p-' + id).classList.add('ok'); updateStats(); }
      fb.innerHTML = right ? `<span class="yes">Richtig!</span>${p.sol ? `<div class="sol">${p.sol}</div>` : ''}` : '<span class="no">Noch nicht. Überlege noch einmal.</span>';
    });
  });
  root.querySelectorAll('.show').forEach(b => b.onclick = () => {
    const id = b.dataset.id, p = PARTS[id], fb = $('#fb-' + id);
    fb.innerHTML = `<div class="sol">${p.sol}</div><button class="btn ghost small mark">Habe ich im Hefter</button>`;
    fb.querySelector('.mark').onclick = () => { S.parts[id] = true; save(); $('#p-' + id).classList.add('ok'); fb.querySelector('.mark').remove(); updateStats(); };
  });
}

