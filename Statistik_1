function partIds(c) { const ids = []; c.tasks.forEach((t, ti) => t.parts.forEach((p, pi) => ids.push(`${c.id}-${ti}-${pi}`))); return ids; }
function updateStats() {
  if (!CUR) return;
  const ids = partIds(CUR), n = ids.filter(i => S.parts[i]).length, el = $('#stats');
  if (el) el.innerHTML = `${n} von ${ids.length} Teilaufgaben geschafft`;
  if (CUR.eingangscheck) evalEC();
}
function evalEC() {
  const box = $('#ec'); if (!box) return;
  const grp = g => CUR.tasks.map((t, ti) => t.group === g ? t.parts.map((p, pi) => `E-${ti}-${pi}`) : []).flat();
  const all = g => grp(g).every(i => S.parts[i]);
  box.innerHTML = `<h3>Mein Ergebnis</h3><p>Teil A: ${all('A') ? '<b class="yes">alles richtig</b>, du kannst Karte 1 überspringen.' : 'noch nicht alles richtig, bearbeite <b>Karte 1</b>.'}</p><p>Teil B: ${all('B') ? '<b class="yes">alles richtig</b>, du kannst Karte 2 überspringen.' : 'noch nicht alles richtig, bearbeite <b>Karte 2</b>.'}</p>`;
}

/* ===== Seiten ===== */
const app = () => $('#app');
function themeOf(id) { return THEMEN.find(t => t.cards.includes(id)); }
function progressStripe() {
  const total = THEMEN.filter(t => !t.optional).reduce((a, t) => a + t.cards.length, 0);
  let x = 0, g = '';
  const W = 1000, H = 64;
  THEMEN.filter(t => !t.optional).forEach(t => {
    const w = t.cards.length / total * W, d = t.cards.filter(c => S.done[c]).length;
    g += `<rect x="${x}" y="0" width="${w - 3}" height="${H}" fill="${t.color}" opacity="0.18" rx="4"/>`;
    g += `<rect x="${x}" y="0" width="${(w - 3) * d / t.cards.length}" height="${H}" fill="${t.color}" rx="4"/>`;
    x += w;
  });
  const done = ORDER.filter(c => !CARDS[c].expert && S.done[c]).length;
  return `<div class="pstripe"><svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true">${g}</svg></div><p class="pnum"><b>${done}</b> von ${total} Karten erledigt</p>`;
}
function home() {
  CUR = null; document.title = 'Statistik 7/8';
  app().innerHTML = `
  <header class="hero">
    <div><h1>Statistik</h1><p class="sub">Freiarbeit Klasse 7/8</p></div>
    ${progressStripe()}
    <p class="legend">${THEMEN.filter(t => !t.optional).map(t => `<span><i style="background:${t.color}"></i>${t.name}</span>`).join('')}</p>
  </header>
  <section class="info">
    <details><summary>Worum geht es?</summary><p>Zahlen und Diagramme begegnen dir jeden Tag: in Nachrichten, in der Werbung, bei Umfragen und im Sport. Hier lernst du, Daten übersichtlich darzustellen, auszuwerten und Diagramme kritisch zu prüfen. Am Anfang wiederholst du Brüche und Prozente.</p></details>
    <details><summary>Das kannst du danach</summary><ul><li>Anteile als Bruch, Dezimalzahl und in Prozent angeben und Prozentaufgaben lösen</li><li>Informationen aus Tabellen und Diagrammen entnehmen und deuten</li><li>Daten in Säulen-, Balken-, Linien-, Streifen- und Kreisdiagrammen darstellen</li><li>ein passendes Diagramm auswählen und begründen</li><li>absolute und relative Häufigkeiten berechnen und vergleichen</li><li>irreführende Diagramme erkennen und erklären</li><li>Mittelwert und Median bestimmen und deuten</li><li>Tabellen und Diagramme am Computer erstellen</li></ul></details>
    <details><summary>So arbeitest du</summary><ol><li>Beginne mit dem Eingangscheck. Er zeigt dir, ob du Karte 1 und 2 brauchst.</li><li>Bearbeite die Karten der Reihe nach und schreibe Datum und Kartennummer in deinen Hefter.</li><li>Übertrage jeden Merke-Kasten 💡📒 in deinen Hefter.</li><li>Rechne im Hefter, gib hier nur das Ergebnis ein. Notiere immer den Rechenweg.</li><li>Alle bearbeiten die Aufgaben Basis. Standard und Knobeln sind die nächsten Stufen.</li><li>Bei Fragen: erst Hefter und Merke-Kästen, dann Mitschüler*innen, dann die Lehrkraft.</li><li>Nach Karte 11 und nach Karte 17 schreibst du einen Test bei der Lehrkraft.</li></ol></details>
  </section>
  ${THEMEN.map(t => `<section class="theme"><h2><i style="background:${t.color}"></i>${t.name}${t.optional ? ' <small>freiwillig</small>' : ''}</h2>
    <div class="grid">${t.cards.map(id => `<button type="button" class="tile ${S.done[id] ? 'done' : ''}" data-go="${id}" style="--c:${t.color}"><span class="nr">${id}</span><span class="tt">${CARDS[id].title}</span>${S.done[id] ? '<span class="tick" aria-label="erledigt">✓</span>' : ''}</button>`).join('')}
    ${t.test ? `<div class="tile test"><span class="nr">${t.test.replace('Test ', 'T')}</span><span class="tt">${t.test} bei der Lehrkraft</span></div>` : ''}</div></section>`).join('')}
  <footer><button class="btn ghost small" id="reset">Fortschritt auf diesem Gerät löschen</button><p>Dein Fortschritt wird nur auf diesem Gerät gespeichert.</p></footer>`;
  $('#reset').onclick = ev => {
    const b = ev.currentTarget;
    if (b.dataset.sure) { S = { done: {}, parts: {} }; save(); home(); }
    else { b.dataset.sure = '1'; b.textContent = 'Wirklich alles löschen? Zum Bestätigen noch einmal tippen'; setTimeout(() => { if (b.isConnected) { delete b.dataset.sure; b.textContent = 'Fortschritt auf diesem Gerät löschen'; } }, 5000); }
  };
  window.scrollTo(0, 0);
}
function showCard(id) {
  const c = CARDS[id]; if (!c) return home();
  CUR = c; document.title = `Karte ${id}: ${c.title}`;
  const t = themeOf(id), i = ORDER.indexOf(id), prev = ORDER[i - 1], next = ORDER[i + 1];
  let html = `<nav class="bar" style="--c:${t.color}"><button type="button" class="btn ghost" data-go="">Übersicht</button><span class="where">${t.name}</span><span class="pn">${prev ? `<button type="button" class="btn ghost" data-go="${prev}" aria-label="vorherige Karte">‹ ${prev}</button>` : ''}${next ? `<button type="button" class="btn ghost" data-go="${next}" aria-label="nächste Karte">${next} ›</button>` : ''}</span></nav>
  <article class="card" style="--c:${t.color}"><header class="ch"><span class="nr">${id}</span><div><p class="th">${c.theme}</p><h1>${c.title}</h1></div></header>`;
  html += c.nomerke ? `<div class="intro">${c.merke}</div>` : `<section class="merke"><div class="mh"><h2>${c.expert ? 'Die Lage' : 'Merke'}</h2>${c.expert ? '' : '<span class="mi" title="Übertrage den Merke-Kasten in deinen Hefter">💡📒 in den Hefter</span>'}</div>${c.merke}</section>`;
  let ta = 0;
  c.tasks.forEach((tk, ti) => {
    if (c.eingangscheck && (ti === 0 || ti === 4)) html += `<h2 class="sect">${ti === 0 ? 'Teil A: Brüche, Dezimalzahlen, Prozente' : 'Teil B: Prozentrechnung'}</h2>`;
    ta++;
    const parts = tk.parts.map((p, pi) => { const pid = `${id}-${ti}-${pi}`; PARTS[pid] = p; return partHTML(p, pid); }).join('');
    html += `<section class="task"><header><span class="ti">${tk.icon || LVL_ICON[tk.lvl] || '✏️'}</span><h3>Aufgabe ${ta}</h3><span class="lvl">${tk.lvl}</span></header>${tk.intro ? `<div class="intro">${tk.intro}</div>` : ''}${parts}</section>`;
  });
  if (c.eingangscheck) html += `<section class="task" id="ec"></section>`;
  if (c.tool) html += `<section class="tool" id="tool"></section>`;
  html += `<footer class="cf"><p id="stats"></p><button class="btn ${S.done[id] ? 'ghost' : ''}" id="done">${S.done[id] ? 'Erledigt ✓ (zurücknehmen)' : 'Karte als erledigt abhaken'}</button>${next ? `<button type="button" class="btn ghost" data-go="${next}">Weiter zu Karte ${next}</button>` : ''}</footer></article>`;
  app().innerHTML = html;
  bindParts(app());
  if (c.tool) TOOLS[c.tool.name]($('#tool'), c.tool.preset);
  $('#done').onclick = () => { S.done[id] = !S.done[id]; save(); showCard(id); };
  updateStats(); window.scrollTo(0, 0);
}
function render(id) { id ? showCard(id) : home(); }
function go(id) {
  render(id);
  try { history.pushState({ id }, '', id ? '#' + encodeURIComponent(id) : location.pathname + location.search); } catch (e) {}
}
document.addEventListener('click', ev => {
  const t = ev.target.closest('[data-go]');
  if (!t) return;
  ev.preventDefault();
  go(t.dataset.go);
});
window.addEventListener('popstate', ev => {
  let id = ev.state && 'id' in ev.state ? ev.state.id : '';
  if (!ev.state) { try { id = decodeURIComponent(location.hash.slice(1)); } catch (e) { id = ''; } }
  render(id);
});
let start = '';
try { start = decodeURIComponent(location.hash.slice(1)); } catch (e) {}
render(CARDS[start] ? start : '');

</script>
