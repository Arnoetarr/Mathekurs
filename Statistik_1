<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Statistik 7/8</title>
<meta name="theme-color" content="#1F6F8B">
<style>
@font-face{font-family:"AH";src:url(data:font/woff2;base64,) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"AH";src:url(data:font/woff2;base64,) format("woff2");font-weight:700;font-display:swap}
:root{
  --petrol:#1F6F8B; --petrol-l:#E6F1F4; --orange:#E8833A; --ink:#1E2B31; --grey:#5F6B70;
  --line:#D5DDE0; --bg:#F3F6F7; --paper:#FFFFFF; --ok:#2F8F5B; --no:#C2452D;
  --c:var(--petrol);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"AH",system-ui,sans-serif;font-size:18px;line-height:1.55}
#app{max-width:860px;margin:0 auto;padding:16px 18px 60px}
h1,h2,h3{line-height:1.2;margin:0}
a{color:inherit}
b{font-weight:700}
.btn{font:inherit;font-weight:700;border:2px solid var(--petrol);background:var(--petrol);color:#fff;border-radius:10px;padding:10px 18px;min-height:48px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;touch-action:manipulation}
.btn.ghost{background:#fff;color:var(--petrol)}
.btn.small{min-height:40px;padding:6px 12px;font-size:16px}
.btn:focus-visible,input:focus-visible,summary:focus-visible,.tile:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
input{font:inherit;font-size:20px;border:2px solid var(--line);border-radius:10px;padding:10px 12px;min-height:48px;width:9em;background:#fff;color:var(--ink)}
input.wide{width:100%}

/* Startseite */
.hero{padding:26px 0 18px}
.hero h1{font-size:64px;letter-spacing:-1px;color:var(--petrol)}
.hero .sub{margin:2px 0 22px;font-size:22px;color:var(--grey)}
.pstripe svg{display:block;width:100%;height:56px}
.pnum{margin:8px 0 2px;font-size:18px}
.legend{display:flex;flex-wrap:wrap;gap:6px 18px;margin:6px 0 0;font-size:16px;color:var(--grey)}
.legend i,.theme h2 i{display:inline-block;width:14px;height:14px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.info{margin:16px 0 8px;background:var(--paper);border-radius:14px;border:1px solid var(--line)}
.info details{border-top:1px solid var(--line)}
.info details:first-child{border-top:0}
.info summary{cursor:pointer;padding:14px 18px;font-weight:700;list-style:none}
.info summary::after{content:"+";float:right;color:var(--petrol);font-size:24px;line-height:1}
.info details[open] summary::after{content:"−"}
.info details>*:not(summary){margin:0 18px 16px}
.theme{margin-top:30px}
.theme h2{font-size:24px;margin-bottom:12px}
.theme h2 small{font-size:16px;color:var(--grey);font-weight:400}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.tile{font:inherit;color:inherit;text-align:left;width:100%;cursor:pointer;-webkit-appearance:none;appearance:none;position:relative;display:flex;gap:14px;align-items:center;background:var(--paper);border:2px solid var(--line);border-radius:12px;padding:12px 14px;text-decoration:none;min-height:78px}
.tile .nr{flex:none;width:50px;height:50px;border-radius:8px;background:var(--c);color:#fff;font-weight:700;font-size:22px;display:grid;place-items:center}
.tile .tt{font-size:17px;line-height:1.3}
.tile.done{border-color:var(--c)}
.tile.done .nr{box-shadow:0 0 0 3px #fff inset}
.tile .tick{position:absolute;top:6px;right:10px;color:var(--ok);font-weight:700;font-size:22px}
.tile.test{border-style:dashed;background:transparent}
.tile.test .nr{background:var(--grey)}
footer{margin-top:40px;color:var(--grey);font-size:16px}

/* Karte */
.bar{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:10px;background:var(--bg);padding:10px 0;border-bottom:3px solid var(--c)}
.bar .where{flex:1;color:var(--grey);font-size:16px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.bar .pn{display:flex;gap:8px}
.ch{display:flex;gap:16px;align-items:center;margin:22px 0 18px}
.ch .nr{flex:none;width:72px;height:72px;border-radius:10px;background:var(--c);color:#fff;font-size:32px;font-weight:700;display:grid;place-items:center}
.ch .th{margin:0;color:var(--grey);font-size:17px}
.ch h1{font-size:32px}
.merke{background:var(--petrol-l);border-left:8px solid var(--c);border-radius:4px 12px 12px 4px;padding:16px 20px;margin-bottom:22px}
.mh{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:6px}
.mh h2{font-size:24px;color:var(--petrol)}
.mi{font-size:15px;color:var(--grey);white-space:nowrap}
.merke p,.intro p{margin:8px 0}
.merke ol,.merke ul{margin:6px 0;padding-left:24px}
.split{display:grid;grid-template-columns:1.1fr 1fr;gap:18px;align-items:center}
.center{text-align:center}
.flow{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.flow span{border:2px solid var(--petrol);border-radius:8px;padding:2px 10px;background:#fff;font-weight:700}
.flow i{font-style:normal;font-size:15px;color:var(--grey)}
.flow i::after{content:" ⟶"}
.hundert{width:150px;height:150px}
.merke .center svg.chart{max-width:210px;margin:0 auto}
.sect{font-size:22px;color:var(--petrol);margin:26px 0 10px}
.task,.tool{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:16px}
.task>header{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.task .ti{font-size:26px}
.task h3{font-size:22px}
.task .lvl{margin-left:auto;font-size:15px;color:var(--grey);border:1px solid var(--line);border-radius:20px;padding:2px 12px}
.part{border-top:1px dashed var(--line);padding:12px 0 6px;position:relative}
.part.ok .q::before{content:"✓ ";color:var(--ok);font-weight:700}
.q{margin-bottom:8px}
.ans{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.unit{color:var(--grey);min-width:1.5em}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{background:#fff;color:var(--ink);border-color:var(--line);font-weight:400;text-align:left}
.opt.sel{border-color:var(--ok);background:#E8F4EC}
.opt.wrong{border-color:var(--no);background:#FBECE8}
.fb{margin-top:6px;min-height:4px}
.yes{color:var(--ok);font-weight:700}
.no{color:var(--no);font-weight:700;margin-right:10px}
.sol{margin-top:8px;background:#F6F8F9;border-left:4px solid var(--ok);padding:8px 12px;border-radius:4px}
.quelle{font-size:14px;color:var(--grey);margin:6px 0 0}
.tw{overflow-x:auto;margin:8px 0}
table{border-collapse:collapse;font-size:17px;background:#fff}
th,td{border:1px solid var(--line);padding:6px 10px;text-align:center}
th{background:#F0F4F5}
svg.chart{width:100%;height:auto;display:block;margin:6px 0;max-width:560px}
svg .grid{stroke:#E3E9EB;stroke-width:1}
svg .axis{stroke:#7A878C;stroke-width:1.5}
svg .tick{font:15px "AH",sans-serif;fill:#3B484E}
svg .ct{font:bold 17px "AH",sans-serif;fill:#1E2B31;text-anchor:middle}
svg .pl{font:bold 15px "AH",sans-serif;fill:#fff}
.tally{vertical-align:middle}
.tally .tl{stroke:#1E2B31;stroke-width:2.2;stroke-linecap:round}
.fr{display:inline-flex;flex-direction:column;vertical-align:middle;text-align:center;line-height:1.1;margin:0 2px}
.fr span:first-child{border-bottom:2px solid currentColor;padding:0 3px}
.chips{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.chips span{border:2px solid #9AA5AA;border-radius:6px;min-width:46px;text-align:center;padding:4px 6px;background:#fff}
.chips span.mid{border-color:var(--orange);background:#FCE9DB;font-weight:700}
.cars{display:flex;align-items:flex-end;gap:30px;margin:8px 0}
.headlines{display:flex;flex-wrap:wrap;gap:12px}
.headlines span{font-weight:700;font-size:21px;padding:10px 16px;border-radius:10px}
.headlines .h1{background:#F7E3B0}.headlines .h2{background:#E2E6E8}
.calc{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff;max-width:340px}
.calc .fx{background:#EEF1F2;padding:6px 10px;font-family:ui-monospace,Menlo,monospace;font-size:15px}
.calc table{width:100%;font-size:15px}.calc .tw{margin:0}
.tool{border:2px solid var(--c)}
.tool h3{font-size:22px;color:var(--petrol);margin-bottom:4px}
.hint{color:var(--grey);font-size:16px;margin:4px 0 12px}
.rows .row{display:flex;gap:8px;margin-bottom:8px}
.rows .row input:first-child{flex:1;width:auto}
.slider{display:block;margin:6px 0 10px}
.slider input{display:block;width:100%;padding:0;border:0;min-height:44px;accent-color:var(--orange)}
.big{font-size:20px}
.warn{color:var(--no)}
.key{display:inline-block;width:22px;height:0;border-top:3px dashed #8E5BC9;vertical-align:middle;margin-right:6px}
.key.k2{border-top:3px solid #2F8F5B}
.noten{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:8px}
.stepper{display:flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:10px;padding:4px 8px;background:#fff}
.stepper b{min-width:1.6em;text-align:center}
.cf{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:24px}
.cf #stats{flex-basis:100%;margin:0;color:var(--grey)}
@media (max-width:640px){
  body{font-size:18px}
  .hero h1{font-size:52px}
  .split{grid-template-columns:1fr}
  .bar .where{display:none}
  .ch h1{font-size:26px}
}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}

</style>
</head>
<body>
<main id="app"></main>
<noscript>Bitte JavaScript aktivieren.</noscript>
<script>
/* ===== Speicher (nur lokal auf dem Gerät) ===== */
const KEY = 'statistik78-v1';
let S = { done: {}, parts: {} };
try { const raw = localStorage.getItem(KEY); if (raw) S = Object.assign(S, JSON.parse(raw)); } catch (e) {}
function save() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {} }

/* ===== Hilfen ===== */
const $ = (sel, el = document) => el.querySelector(sel);
const fmt = (x, d = 2) => {
  const r = Math.round(x * Math.pow(10, d)) / Math.pow(10, d);
  return String(r).replace('.', ',');
};
function parseNum(s) {
  if (s == null) return NaN;
  s = String(s).trim().replace(/\s/g, '').replace(/[€%°a-zA-ZäöüÄÖÜ]/g, '');
  if (/^-?\d{1,3}(\.\d{3})+(,\d+)?$/.test(s)) s = s.replace(/\./g, '');
  s = s.replace(',', '.');
  return parseFloat(s);
}
function gcd(a, b) { return b ? gcd(b, a % b) : Math.abs(a); }
function esc(s) { return String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])); }
const FR = (n, d) => `<span class="fr"><span>${n}</span><span>${d}</span></span>`;

/* ===== Diagramme (SVG) ===== */
const COL = ['#1F6F8B', '#E8833A', '#7FA83A', '#E9B949', '#8E5BC9', '#9AA5AA'];
function svgWrap(w, h, inner, label) {
  return `<svg class="chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="${esc(label || 'Diagramm')}">${inner}</svg>`;
}
function niceTicks(min, max, n = 5) {
  const span = max - min, raw = span / n, mag = Math.pow(10, Math.floor(Math.log10(raw)));
  const step = [1, 2, 2.5, 5, 10].map(m => m * mag).find(s => span / s <= n) || mag * 10;
  const t = []; for (let v = Math.ceil(min / step) * step; v <= max + 1e-9; v += step) t.push(+v.toFixed(6));
  return t;
}
function barChart(o) {
  const W = 520, H = o.h || 280, L = 56, R = 16, T = o.title ? 34 : 14, B = 46;
  const ymin = o.ymin || 0, ymax = o.ymax, cats = o.labels, ser = o.series;
  const pw = W - L - R, ph = H - T - B, gw = pw / cats.length, bw = Math.min(46, gw * 0.7 / ser.length);
  const y = v => T + ph - (v - ymin) / (ymax - ymin) * ph;
  let g = '';
  if (o.title) g += `<text x="${W / 2}" y="20" class="ct">${esc(o.title)}</text>`;
  for (const t of (o.ticks || niceTicks(ymin, ymax))) {
    g += `<line x1="${L}" x2="${W - R}" y1="${y(t)}" y2="${y(t)}" class="grid"/><text x="${L - 6}" y="${y(t) + 5}" class="tick" text-anchor="end">${fmt(t)}</text>`;
  }
  cats.forEach((c, i) => {
    const x0 = L + i * gw + (gw - bw * ser.length) / 2;
    ser.forEach((s, j) => {
      const v = s.values[i], yy = y(Math.max(v, ymin));
      g += `<rect x="${x0 + j * bw}" y="${yy}" width="${bw - 2}" height="${T + ph - yy}" fill="${s.color || COL[j]}" rx="2"/>`;
      if (o.values) g += `<text x="${x0 + j * bw + bw / 2 - 1}" y="${yy - 5}" class="tick" text-anchor="middle">${fmt(v, 1)}</text>`;
    });
    g += `<text x="${L + i * gw + gw / 2}" y="${H - B + 20}" class="tick" text-anchor="middle">${esc(c)}</text>`;
  });
  g += `<line x1="${L}" x2="${W - R}" y1="${T + ph}" y2="${T + ph}" class="axis"/><line x1="${L}" x2="${L}" y1="${T}" y2="${T + ph}" class="axis"/>`;
  if (o.ylabel) g += `<text transform="translate(14 ${T + ph / 2}) rotate(-90)" class="tick" text-anchor="middle">${esc(o.ylabel)}</text>`;
  if (ser.length > 1) ser.forEach((s, j) => {
    g += `<rect x="${L + 10 + j * 110}" y="${H - 16}" width="12" height="12" fill="${s.color || COL[j]}"/><text x="${L + 28 + j * 110}" y="${H - 6}" class="tick">${esc(s.name)}</text>`;
  });
  return svgWrap(W, H, g, o.title);
}
function hbarChart(o) {
  const W = 520, rowH = 34, T = o.title ? 34 : 10, L = 120, R = 40, H = T + o.labels.length * rowH + 40;
  const pw = W - L - R, x = v => L + v / o.xmax * pw;
  let g = o.title ? `<text x="${W / 2}" y="20" class="ct">${esc(o.title)}</text>` : '';
  for (const t of niceTicks(0, o.xmax)) g += `<line x1="${x(t)}" x2="${x(t)}" y1="${T}" y2="${T + o.labels.length * rowH}" class="grid"/><text x="${x(t)}" y="${T + o.labels.length * rowH + 18}" class="tick" text-anchor="middle">${fmt(t)}</text>`;
  o.labels.forEach((l, i) => {
    g += `<rect x="${L}" y="${T + i * rowH + 6}" width="${x(o.values[i]) - L}" height="${rowH - 12}" fill="${o.color || COL[0]}" rx="2"/>`;
    g += `<text x="${L - 8}" y="${T + i * rowH + rowH / 2 + 5}" class="tick" text-anchor="end">${esc(l)}</text>`;
    g += `<text x="${x(o.values[i]) + 5}" y="${T + i * rowH + rowH / 2 + 5}" class="tick">${fmt(o.values[i], 1)}</text>`;
  });
  if (o.xlabel) g += `<text x="${L + pw / 2}" y="${H - 4}" class="tick" text-anchor="middle">${esc(o.xlabel)}</text>`;
  return svgWrap(W, H, g, o.title);
}
function lineChart(o) {
  const W = 520, H = o.h || 280, L = 56, R = 16, T = o.title ? 34 : 14, B = 46;
  const xs = o.x, ys = o.y, pw = W - L - R, ph = H - T - B;
  const xmin = o.xmin ?? xs[0], xmax = o.xmax ?? xs[xs.length - 1];
  const X = v => L + (v - xmin) / (xmax - xmin) * pw, Y = v => T + ph - (v - o.ymin) / (o.ymax - o.ymin) * ph;
  let g = o.title ? `<text x="${W / 2}" y="20" class="ct">${esc(o.title)}</text>` : '';
  for (const t of (o.ticks || niceTicks(o.ymin, o.ymax))) g += `<line x1="${L}" x2="${W - R}" y1="${Y(t)}" y2="${Y(t)}" class="grid"/><text x="${L - 6}" y="${Y(t) + 5}" class="tick" text-anchor="end">${fmt(t)}</text>`;
  xs.forEach(v => g += `<text x="${X(v)}" y="${T + ph + 20}" class="tick" text-anchor="middle">${o.xfmt ? o.xfmt(v) : v}</text>`);
  (o.refs || []).forEach(r => g += `<line x1="${L}" x2="${W - R}" y1="${Y(r.y)}" y2="${Y(r.y)}" stroke="${r.color}" stroke-width="2" stroke-dasharray="6 5"/><text x="${W - R - 4}" y="${Y(r.y) - 6}" class="tick" text-anchor="end" fill="${r.color}">${esc(r.label)}</text>`);
  g += `<polyline points="${xs.map((v, i) => X(v) + ',' + Y(ys[i])).join(' ')}" fill="none" stroke="${o.color || COL[0]}" stroke-width="3" stroke-linejoin="round"/>`;
  xs.forEach((v, i) => g += `<circle cx="${X(v)}" cy="${Y(ys[i])}" r="4.5" fill="${o.color || COL[0]}"/>`);
  g += `<line x1="${L}" x2="${W - R}" y1="${T + ph}" y2="${T + ph}" class="axis"/><line x1="${L}" x2="${L}" y1="${T}" y2="${T + ph}" class="axis"/>`;
  if (o.ylabel) g += `<text transform="translate(14 ${T + ph / 2}) rotate(-90)" class="tick" text-anchor="middle">${esc(o.ylabel)}</text>`;
  if (o.xlabel) g += `<text x="${L + pw / 2}" y="${H - 4}" class="tick" text-anchor="middle">${esc(o.xlabel)}</text>`;
  return svgWrap(W, H, g, o.title);
}
function pieChart(o) {
  const W = o.nolegend ? 260 : 520, H = 260, cx = 130, cy = 130, r = 112, sum = o.values.reduce((a, b) => a + b, 0);
  let a = -Math.PI / 2, g = '';
  o.values.forEach((v, i) => {
    const da = v / sum * 2 * Math.PI, a2 = a + da, col = (o.colors || COL)[i % 6];
    if (v > 0) {
      if (da >= 2 * Math.PI - 1e-6) g += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${col}"/>`;
      else g += `<path d="M${cx},${cy} L${cx + r * Math.cos(a)},${cy + r * Math.sin(a)} A${r},${r} 0 ${da > Math.PI ? 1 : 0} 1 ${cx + r * Math.cos(a2)},${cy + r * Math.sin(a2)} Z" fill="${col}" stroke="#fff" stroke-width="2"/>`;
      const p = v / sum * 100;
      if (o.pct !== false && p >= 6) g += `<text x="${cx + r * 0.65 * Math.cos(a + da / 2)}" y="${cy + r * 0.65 * Math.sin(a + da / 2) + 5}" class="pl" text-anchor="middle">${fmt(p, 0)} %</text>`;
    }
    if (!o.nolegend) g += `<rect x="290" y="${30 + i * 30}" width="16" height="16" rx="3" fill="${col}"/><text x="314" y="${43 + i * 30}" class="tick">${esc(o.labels[i])}</text>`;
    a = a2;
  });
  return svgWrap(W, H, g, o.title || 'Kreisdiagramm');
}
function stripe(o) {
  const W = 520, H = 92, L = 10, pw = W - 20, sum = o.values.reduce((a, b) => a + b, 0);
  let x = L, g = '';
  o.values.forEach((v, i) => {
    const w = v / sum * pw, col = (o.colors || COL)[i % 6];
    g += `<rect x="${x}" y="10" width="${w}" height="44" fill="${col}" stroke="#fff" stroke-width="2"/>`;
    if (w > 34) g += `<text x="${x + w / 2}" y="38" class="pl" text-anchor="middle">${fmt(v / sum * 100, 0)} %</text>`;
    x += w;
  });
  let lx = L;
  o.labels.forEach((l, i) => { g += `<rect x="${lx}" y="68" width="12" height="12" fill="${(o.colors || COL)[i % 6]}"/><text x="${lx + 16}" y="79" class="tick">${esc(l)}</text>`; lx += 22 + l.length * 8.2; });
  return svgWrap(W, H, g, 'Streifendiagramm');
}
function tally(n) {
  let g = '', x = 4;
  for (let b = 0; b < Math.floor(n / 5); b++) { for (let s = 0; s < 4; s++) g += `<line x1="${x + s * 7}" y1="4" x2="${x + s * 7}" y2="26" class="tl"/>`; g += `<line x1="${x - 3}" y1="22" x2="${x + 24}" y2="8" class="tl"/>`; x += 38; }
  for (let s = 0; s < n % 5; s++) g += `<line x1="${x + s * 7}" y1="4" x2="${x + s * 7}" y2="26" class="tl"/>`;
  return `<svg class="tally" viewBox="0 0 ${x + 40} 30" width="${x + 40}" height="30" aria-label="${n} Striche">${g}</svg>`;
}
function table(rows, head = true) {
  return `<div class="tw"><table>${rows.map((r, i) => `<tr>${r.map(c => (head && i === 0) ? `<th>${c}</th>` : `<td>${c}</td>`).join('')}</tr>`).join('')}</table></div>`;
}
const quelle = s => `<p class="quelle">Quelle: ${s}</p>`;

/* ===== Aufgabentypen ===== */
const N = (q, ans, o = {}) => ({ t: 'num', q, ans, tol: o.tol ?? 0.01, unit: o.unit || '', sol: o.sol });
const F = (q, n, d, o = {}) => ({ t: 'frac', q, n, d, sol: o.sol });
const C = (q, opts, ok, o = {}) => ({ t: 'choice', q, opts, ok, sol: o.sol });
const O = (q, sol) => ({ t: 'open', q, sol });
function hundert(n) {
  let g = '';
  for (let k = 0; k < 100; k++) { const c = k % 10, r = Math.floor(k / 10); g += `<rect x="${c * 14 + 1}" y="${r * 14 + 1}" width="13" height="13" rx="2" fill="${k < n ? '#E8833A' : '#fff'}" stroke="#C9D3D7"/>`; }
  return `<svg class="hundert" viewBox="0 0 142 142" role="img" aria-label="Hunderterfeld, ${n} von 100 gefärbt">${g}</svg>`;
}

