  ausreisser(el) {
    const base = [10, 10, 15, 15, 20];
    el.innerHTML = `<h3>Werkstatt: Ausreißer</h3><p class="hint">Fünf Lernende bekommen 10 €, 10 €, 15 €, 15 € und 20 € Taschengeld. Verändere das Taschengeld der sechsten Person.</p><label class="slider">Sechste Person: <b class="v"></b> €<input type="range" min="0" max="200" value="100" step="5"></label><div class="out"></div>`;
    const s = $('input', el), out = $('.out', el), v = $('.v', el);
